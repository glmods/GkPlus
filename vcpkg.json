{
    "$schema": "https://raw.githubusercontent.com/microsoft/vcpkg-tool/main/docs/vcpkg.schema.json",
    "dependencies": [
        {
            "name": "imgui",
            "features": [
                "dx9-binding",
                "vulkan-binding",
                "win32-binding"
            ]
        },
        "d3d8to9",
        "detours",
        "vulkan-headers",
        "vulkan-memory-allocator",
        "volk",
        "quickjs-ng",
        "dear-bindings",
        "physfs"
    ],
    "features": {
        "rimutil": {
            "description": "Utility to convert images to and from RIM files",
            "dependencies": [
                "libsquish",
                "libspng"
            ]
        }
    },
    "supports": "windows & x86"
}